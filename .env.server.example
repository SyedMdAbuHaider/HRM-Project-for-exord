# Exord HRM server configuration
# NEVER commit a real .env file.

NODE_ENV=production
HOST=127.0.0.1
PORT=8081

# Database
DATABASE_URL=postgresql://exord_hrm:CHANGE_ME@127.0.0.1:5432/exord_hrm
DATABASE_SSL=false

# Redis
REDIS_URL=redis://127.0.0.1:6379

# Browser/API access
CORS_ORIGINS=https://admin.exord.net

# Transitional attendance API
ATTENDANCE_API_KEY=CHANGE_ME

# Email
RESEND_API_KEY=CHANGE_ME
MAIL_FROM=Exord Online HRM <hr@exord.net>

# Auth secrets — generate long random values
ACCESS_TOKEN_SECRET=CHANGE_ME
REFRESH_TOKEN_SECRET=CHANGE_ME
